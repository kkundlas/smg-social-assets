{
  "name": "KundlasMD YouTube Layout",
  "canvas": {
    "logicalWidth": 1920,
    "logicalHeight": 1080,
    "masterWidth": 3840,
    "masterHeight": 2160,
    "fps": 30,
    "aspect": "16:9",
    "safeArea": {"left": 80, "right": 80, "top": 100, "bottom": 100},
    "semanticOverlay": {"bottomMin": 105, "bottomMax": 125, "horizontal": "center"},
    "logoOffset": {"left": 80, "topMin": 80, "topMax": 100}
  },
  "brand": {
    "channel": "KundlasMD only",
    "forbiddenText": ["Shield Medical Group"],
    "logo": {
      "path": "assets/kundlas-md-logo.png",
      "placement": "upper-left",
      "maximumVisibleInstances": 1,
      "finalCompositorOwnsLogo": true,
      "nestedAssetsMustBeLogoFree": true
    }
  },
  "type": {
    "display": "Bebas Neue",
    "displayRule": "short all-caps display, maximum about 6 words",
    "body": "Lato",
    "forbidden": ["Google Sans"],
    "ramp": {
      "eyebrowXS": {"min": 28, "max": 36},
      "bodyS": {"min": 36, "max": 44},
      "semanticOverlay": {"min": 44, "max": 64},
      "titleXL": {"min": 72, "max": 96},
      "factXXL": {"min": 160, "max": 220}
    }
  },
  "colors": {
    "deepTeal": "#12343B",
    "signalYellow": "#F5D10A",
    "warmOffWhite": "#F4F3EE",
    "softBlack": "#231F20",
    "crimson": "#96151D",
    "slate": "#3C4651",
    "steelBlue": "#558BA5",
    "sage": "#788C5D",
    "retiredNever": ["#9A0718", "#F72736", "#0F62FE", "#1F70C1"],
    "maxChromaticPerFrame": 4,
    "neverSignalYellowOn": ["#FFFFFF", "#F4F3EE"]
  },
  "layoutKeys": ["intro", "outro", "chapter", "speaker", "captions", "text", "list", "paragraph", "quote", "bigfact", "audiogram", "screen", "multicam"],
  "presenter": {
    "preserveRecordedBackground": true,
    "preferredInsetShape": "rectangle",
    "forbidDecorativeCircularMugshot": true,
    "protectHeadroom": true,
    "protectMouthFromOverlays": true
  },
  "voice": {
    "disclaimer": "Educational only; this is not personalized medical advice. Talk to your clinician.",
    "identity": "Kulmeet Singh Kundlas, MD"
  }
}
